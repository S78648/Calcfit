# Copy to .env (gitignored) and fill in real values.
# Spring loads ./.env automatically (see spring.config.import in application.yaml).

# Docker compose (db container)
POSTGRES_DB=calorie_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local dev profile datasource
DB_URL=jdbc:postgresql://localhost:5432/calorie_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT (secret must be >= 32 bytes; generate with: openssl rand -hex 64)
JWT_ISSUER=calcfit
JWT_SECRET=replace-with-your-secret
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
